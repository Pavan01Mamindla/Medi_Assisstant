# Copy this file to .env and fill in your own values. NEVER commit .env.

# Long random string used to sign sessions and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Anthropic API key. Leave empty to run in clearly-labelled DEMO MODE.
ANTHROPIC_API_KEY=

# Claude model used for the chatbot (override if you prefer another model).
ANTHROPIC_MODEL=claude-sonnet-5-5

# SQLite database location (relative to the project folder).
DATABASE_URL=sqlite:///mediassist.db

# Set to 1 only when serving over HTTPS (marks session cookie as Secure).
SESSION_COOKIE_SECURE=0

# Optional: used by `flask --app run create-admin` to avoid the interactive prompt.
# ADMIN_USERNAME=staff
# ADMIN_PASSWORD=
